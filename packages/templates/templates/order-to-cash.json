{
  "schemaVersion": 1,
  "id": "order-to-cash",
  "name": "Order-to-cash",
  "description": "Orders are validated, credit-checked where needed, invoiced, and closed. Validation and invoicing are agentification candidates; exceptions route to credit review and a billing-exceptions queue.",
  "pools": [
    { "id": "order-team", "name": "Order management", "capacity": 4, "hourlyCostPerServer": 30 },
    { "id": "credit-team", "name": "Credit team", "capacity": 2, "hourlyCostPerServer": 45 },
    { "id": "billing", "name": "Billing team", "capacity": 3, "hourlyCostPerServer": 32 }
  ],
  "nodes": [
    { "id": "arrivals", "kind": "source", "name": "Orders received", "out": "validate", "arrival": { "kind": "poisson", "ratePerHour": 15 } },
    {
      "id": "validate", "kind": "activity", "name": "Order validation", "out": "credit-check", "execution": "human",
      "human": { "poolId": "order-team", "serviceTime": { "kind": "lognormal", "mean": 0.15, "cv": 0.6 } },
      "agent": { "serviceTime": { "kind": "constant", "value": 0.004 }, "costPerCase": 0.06, "escalation": { "probability": 0.05, "toNodeId": "credit-review" } }
    },
    {
      "id": "credit-check", "kind": "gateway", "name": "Credit check",
      "branches": [ { "to": "invoice", "probability": 0.8 }, { "to": "credit-review", "probability": 0.2 } ]
    },
    {
      "id": "credit-review", "kind": "activity", "name": "Credit review", "out": "invoice", "execution": "human",
      "human": { "poolId": "credit-team", "serviceTime": { "kind": "lognormal", "mean": 0.35, "cv": 0.6 } }
    },
    {
      "id": "invoice", "kind": "activity", "name": "Invoicing", "out": "done", "execution": "human",
      "human": { "poolId": "billing", "serviceTime": { "kind": "lognormal", "mean": 0.15, "cv": 0.6 } },
      "agent": { "serviceTime": { "kind": "constant", "value": 0.005 }, "costPerCase": 0.08, "escalation": { "probability": 0.06, "toNodeId": "billing-exceptions" } }
    },
    {
      "id": "billing-exceptions", "kind": "activity", "name": "Billing exception handling", "out": "done", "execution": "human",
      "human": { "poolId": "order-team", "serviceTime": { "kind": "lognormal", "mean": 0.4, "cv": 0.7 } }
    },
    { "id": "done", "kind": "sink", "name": "Order billed" }
  ]
}
