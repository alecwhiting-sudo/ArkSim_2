{
  "schemaVersion": 1,
  "id": "kyc-onboarding",
  "name": "KYC / customer onboarding & compliance",
  "description": "New customers pass ID verification and sanctions/PEP screening; flagged cases go to enhanced due diligence (EDD) before account approval. Verification, screening, and approval are agentification candidates; escalations feed the EDD queue.",
  "pools": [
    { "id": "analysts", "name": "KYC analysts", "capacity": 5, "hourlyCostPerServer": 38 },
    { "id": "senior-analysts", "name": "Senior compliance", "capacity": 2, "hourlyCostPerServer": 55 }
  ],
  "nodes": [
    { "id": "arrivals", "kind": "source", "name": "Onboarding requests", "out": "id-verify", "arrival": { "kind": "poisson", "ratePerHour": 10 } },
    {
      "id": "id-verify", "kind": "activity", "name": "ID verification", "out": "screening", "execution": "human",
      "human": { "poolId": "analysts", "serviceTime": { "kind": "lognormal", "mean": 0.12, "cv": 0.5 } },
      "agent": { "serviceTime": { "kind": "constant", "value": 0.004 }, "costPerCase": 0.08, "escalation": { "probability": 0.04, "toNodeId": "edd" } }
    },
    {
      "id": "screening", "kind": "activity", "name": "Sanctions/PEP screening", "out": "risk", "execution": "human",
      "human": { "poolId": "analysts", "serviceTime": { "kind": "lognormal", "mean": 0.15, "cv": 0.7 } },
      "agent": { "serviceTime": { "kind": "constant", "value": 0.005 }, "costPerCase": 0.1, "escalation": { "probability": 0.08, "toNodeId": "edd" } }
    },
    {
      "id": "risk", "kind": "gateway", "name": "Risk rating",
      "branches": [ { "to": "approve", "probability": 0.85 }, { "to": "edd", "probability": 0.15 } ]
    },
    {
      "id": "edd", "kind": "activity", "name": "Enhanced due diligence", "out": "approve", "execution": "human",
      "human": { "poolId": "senior-analysts", "serviceTime": { "kind": "lognormal", "mean": 0.7, "cv": 0.6 } }
    },
    {
      "id": "approve", "kind": "activity", "name": "Account approval", "out": "done", "execution": "human",
      "human": { "poolId": "analysts", "serviceTime": { "kind": "constant", "value": 0.05 } },
      "agent": { "serviceTime": { "kind": "constant", "value": 0.002 }, "costPerCase": 0.02 }
    },
    { "id": "done", "kind": "sink", "name": "Customer onboarded" }
  ]
}
